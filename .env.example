# ---- Database ----
POSTGRES_USER=loqal
POSTGRES_PASSWORD=change-me

# ---- App ----
APP_PORT=8080

# ---- JWT signing keys (REQUIRED, must persist across restarts) ----
# Generate a private key (PKCS#8) base64-encoded:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 \
#     | openssl pkcs8 -topk8 -nocrypt | tr -d '\n'
# Derive the matching public key (SPKI) base64-encoded:
#   openssl pkey -in private.pem -pubout | tr -d '\n'
JWT_RSA_PRIVATE_KEY=
JWT_RSA_PUBLIC_KEY=
#
# The platform derives a stable `kid` from the public key (UUID v3 of the
# RSA modulus, matching Java's UUID.nameUUIDFromBytes). Kong's consumer
# credential in kong.yml MUST use this kid as its `key` and the public key
# PEM as `rsa_public_key`. Compute it with:
#
#   MOD=$(openssl pkey -in private.pem -pubout -text -noout \
#         | awk '/Modulus/{f=1;next} /Exponent/{f=0} f' | tr -d ' :\n')
#   python3 -c "import hashlib,uuid; n=int('$MOD',16); b=n.to_bytes((n.bit_length()+8)//8,'big',signed=True); print(uuid.UUID(bytes=hashlib.md5(b).digest()[:16],version=3))"

# Refresh token TTL in ms (default 7 days)
REFRESH_TOKEN_EXPIRATION=604800000

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ---- Payments (Razorpay) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# After filling this file:
#   1. Fill kong.yml jwt_secrets: `key` = computed kid, `rsa_public_key` = public PEM
#   2. docker compose up -d
