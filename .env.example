# ---- Database ----
POSTGRES_USER=loqal
POSTGRES_PASSWORD=change-me

# ---- App ----
APP_PORT=8080

# ---- JWT signing keys (REQUIRED, must persist across restarts) ----
# Generate a private key (PKCS#8) base64-encoded:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 \
#     | openssl pkcs8 -topk8 -nocrypt | tr -d '\n'
# Derive the matching public key (SPKI) base64-encoded:
#   openssl pkey -in private.pem -pubout | tr -d '\n'
JWT_RSA_PRIVATE_KEY=
JWT_RSA_PUBLIC_KEY=

# Refresh token TTL in ms (default 7 days)
REFRESH_TOKEN_EXPIRATION=604800000

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ---- Payments (Razorpay) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# After filling this file:
#   1. Decode your private key to PEM for the Kong config if needed:
#      echo "$JWT_RSA_PRIVATE_KEY" | base64 -d > private.pem
#      openssl pkey -in private.pem -pubout   # paste into kong.yml jwt_secrets
#   2. docker compose up -d
